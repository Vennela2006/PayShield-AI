# PayShield AI environment configuration
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.

# PostgreSQL (required for investigation case/evidence persistence)
DATABASE_URL=

# Auth.js
# Generate a strong random value, for example with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional demo credentials provider.
# DEMO_PASSWORD_HASH format: pbkdf2:<iterations>:<salt>:<64-character-hex-sha256-hash>
# Do not put a plaintext password here.
DEMO_EMAIL=
DEMO_PASSWORD_HASH=

# PayPal Sandbox REST app credentials.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Local: http://localhost:3000
# Render: set this to the deployed HTTPS application URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side human approval PIN. Set a strong value outside source control.
PAYSHIELD_APPROVAL_PIN=

# Optional PaddleOCR service URL, e.g. http://localhost:8001
OCR_SERVICE_URL=

# Optional AI service key; never expose this in NEXT_PUBLIC_ variables.
OPENAI_API_KEY=

# Optional: set only after obtaining an AG Studio license through the sponsor.
AG_STUDIO_LICENSE_KEY=
